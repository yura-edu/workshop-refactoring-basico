{
  "schemaVersion": "1.0",
  "templateSlug": "refactoring-basico",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "cyclomatic_complexity",
          "worker": "MetricsWorker",
          "weight": 35,
          "threshold": 10,
          "config": {
            "tool": "complexity-report",
            "maxAllowed": 10,
            "targetFiles": ["src/**/*.js"]
          }
        },
        {
          "metricKey": "code_duplication",
          "worker": "MetricsWorker",
          "weight": 35,
          "threshold": 0.03,
          "config": {
            "tool": "jscpd",
            "minTokens": 50,
            "targetFiles": ["src/**/*.js"]
          }
        },
        {
          "metricKey": "loc_delta",
          "worker": "MetricsWorker",
          "weight": 30,
          "threshold": -50,
          "config": {
            "baseBranch": "main",
            "countDeletedLines": true
          }
        }
      ]
    }
  ]
}
